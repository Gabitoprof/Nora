# Copy this file to .env and fill it in. The .env NEVER goes to GitHub.

# Anthropic API key (Claude; console.anthropic.com, pay per use). Optional.
# Set a spending limit in the Console.
ANTHROPIC_API_KEY=

# OpenAI API key (ChatGPT; platform.openai.com, pay per use). Optional.
# Default for complex questions; without it, Claude answers.
OPENAI_API_KEY=

# ElevenLabs key (cloud voice, optional; only if [voz] motor = "elevenlabs").
ELEVENLABS_API_KEY=

# Ollama address (default: on this machine).
OLLAMA_HOST=http://127.0.0.1:11434

# Optional: another config file in place of config/nora.toml.
# ELLA_CONFIG=

# Commit of this installation, shown in `nora --verificar` and in the HUD so acceptance records
# what was tested. Only for packaged installations (without the .git folder); in a checkout, Nora
# reads the commit from git on her own. Leave it empty.
NORA_COMMIT=

# Nora's folder (personal config, .env, memory, models). Default: the repository root during
# development; %APPDATA%\Nora when installed. Set it in the system variables (not here: this
# .env lives inside it). Leave it empty.
NORA_HOME=

# HUD build folder (index.html), if it is not the one inside the program or hud/dist. Leave it empty.
NORA_HUD_DIST=
