# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.

# Chave da API da Anthropic (Claude; console.anthropic.com, pago por uso). Opcional.
# Defina um limite de gasto no Console.
ANTHROPIC_API_KEY=

# Chave da API da OpenAI (ChatGPT; platform.openai.com, pago por uso). Opcional.
# Padrão para as perguntas complexas; sem ela, o Claude responde.
OPENAI_API_KEY=

# Chave do ElevenLabs (voz na nuvem, opcional; só se [voz] motor = "elevenlabs").
ELEVENLABS_API_KEY=

# Endereço do Ollama (padrão: na própria máquina).
OLLAMA_HOST=http://127.0.0.1:11434

# Opcional: outro arquivo de config no lugar de config/nora.toml.
# ELLA_CONFIG=
