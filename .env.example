# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.

# Chave da API da Anthropic (Console, pago por uso). Só é usada a partir da v0.3.0.
# Defina um limite de gasto no Console.
ANTHROPIC_API_KEY=

# Chave do ElevenLabs (voz na nuvem, opcional; só se [voz] motor = "elevenlabs").
ELEVENLABS_API_KEY=

# Endereço do Ollama (padrão: na própria máquina).
OLLAMA_HOST=http://127.0.0.1:11434

# Opcional: outro arquivo de config no lugar de config/ella.toml.
# ELLA_CONFIG=
